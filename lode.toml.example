# lode configuration example.
# Full reference: docs/configuration.md

# Config schema version. Omit to use the current version.
version = 1

[embedding]
# Embedding provider. Options: openai_compatible, tei_native, ollama.
# Only the matching `[embedding.<provider>]` table is read.
provider = "openai_compatible"

# Model name; discovered from the endpoint when omitted.
# Set explicitly when the endpoint hosts multiple models.
# model = "BAAI/bge-small-zh-v1.5"

# Native output dimension; discovered when omitted.
# Changing this value requires re-mining the index.
# model_dimension = 512

# Requested output dimension (subset of model_dimension); unset = full.
# Changing this value requires re-mining the index.
# output_dimension = 256

# L2-normalize vectors so cosine similarity becomes a dot product.
l2_normalize = true

# Texts per embedding request.
batch_size = 32


[embedding.openai_compatible]
# Only loaded when provider = "openai_compatible".
endpoint = "https://api.openai.com/v1"
# Never commit a key; prefer LODE_EMBEDDING__OPENAI_COMPATIBLE__KEY.
# key = ""
max_retries = 3
timeout = 60.0


[embedding.tei_native]
# Only loaded when provider = "tei_native".
endpoint = "http://localhost:8080"
# key = ""
max_retries = 3
timeout = 60.0
truncate = false
# Truncation side; only applies when truncate = true. Options: left, right.
truncation_direction = "right"


[embedding.ollama]
# Only loaded when provider = "ollama".
endpoint = "http://localhost:11434"
# key = ""
max_retries = 3
timeout = 60.0
truncate = true


[retrieval]
# Max results returned by `lode prospect`.
top_k = 10

[retrieval.norm]
# Per-source score normalization before fusion. Options: minmax, softmax.
# Skipped when fusion.type = "rrf".
type = "softmax"

[retrieval.norm.softmax]
# Only loaded when norm.type = "softmax".
temperature = 1.0

[retrieval.fusion]
# How per-source scores combine. Options: linear, rrf.
type = "linear"

[retrieval.fusion.linear]
# Only loaded when fusion.type = "linear".
# Final score = semantic * semantic_factor + lexical * lexical_factor.
# Factors may be negative; they must not both be zero.
semantic_factor = 0.7
lexical_factor = 0.3

[retrieval.fusion.rrf]
# Only loaded when fusion.type = "rrf".
k = 60


[chunking]
# Chunk size and overlap for splitting documents.
# Changing these requires re-mining the index.
size = 1024
overlap = 128


[app.ignore]
# Additional ignore files (gitignore semantics).
# `.lodeignore` is always loaded and does not need to be listed.
sources = [".gitignore"]


[fts]
# FTS5 tokenizer. Options: unicode61, trigram, simple, jieba.
# simple and jieba share the same index tokenizer (switching needs no re-mine);
# any other change requires re-mining.
strategy = "simple"

[app.output]
# Color palette. Options: ansi, accessible_light, accessible_dark.
palette = "ansi"
# Disable color: true = never, false = always, unset = follow NO_COLOR (default).
# no_color = false
